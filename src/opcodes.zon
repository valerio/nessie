// Opcode metadata for the NES cpu, this helps generate comptime mappings and reduce boilerplate.
// Fields:
// - op: opcode byte,
// - mnemonic: identifier of the instruction (family)
// - mode: addressing mode, affects how operands (if any) are loaded
// - bytes: number of bytes in the opcode
// - forceDummyRead: true for instructions that always have the "oops" cycle
//   this is true for e.g. store instructions, they always read from the wrong
//   address at first, so we need to do a dummy read to get the correct address.
//
// This structure is for more readable definitions, these should be converted to a more compact form
// at comptime before use.
.{
    .{ .op = 0xea, .mnemonic = .nop, .mode = .implied, .bytes = 1 },
    .{ .op = 0x00, .mnemonic = .brk, .mode = .implied, .bytes = 1 },

    .{ .op = 0xa9, .mnemonic = .lda, .mode = .immediate, .bytes = 2 },
    .{ .op = 0xa2, .mnemonic = .ldx, .mode = .immediate, .bytes = 2 },
    .{ .op = 0xa0, .mnemonic = .ldy, .mode = .immediate, .bytes = 2 },
    .{ .op = 0xa5, .mnemonic = .lda, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0xa6, .mnemonic = .ldx, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0xa4, .mnemonic = .ldy, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0xb5, .mnemonic = .lda, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0xb4, .mnemonic = .ldy, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0xb6, .mnemonic = .ldx, .mode = .zeroPageY, .bytes = 2 },
    .{ .op = 0xad, .mnemonic = .lda, .mode = .absolute, .bytes = 3 },
    .{ .op = 0xae, .mnemonic = .ldx, .mode = .absolute, .bytes = 3 },
    .{ .op = 0xac, .mnemonic = .ldy, .mode = .absolute, .bytes = 3 },
    .{ .op = 0xbd, .mnemonic = .lda, .mode = .absoluteX, .bytes = 3 },
    .{ .op = 0xb9, .mnemonic = .lda, .mode = .absoluteY, .bytes = 3 },
    .{ .op = 0xbe, .mnemonic = .ldx, .mode = .absoluteY, .bytes = 3 },
    .{ .op = 0xbc, .mnemonic = .ldy, .mode = .absoluteX, .bytes = 3 },
    .{ .op = 0xa1, .mnemonic = .lda, .mode = .indirectX, .bytes = 2 },
    .{ .op = 0xb1, .mnemonic = .lda, .mode = .indirectY, .bytes = 2 },

    .{ .op = 0x29, .mnemonic = .@"and", .mode = .immediate, .bytes = 2 },
    .{ .op = 0x25, .mnemonic = .@"and", .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0x35, .mnemonic = .@"and", .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0x2d, .mnemonic = .@"and", .mode = .absolute, .bytes = 3 },
    .{ .op = 0x3d, .mnemonic = .@"and", .mode = .absoluteX, .bytes = 3 },
    .{ .op = 0x39, .mnemonic = .@"and", .mode = .absoluteY, .bytes = 3 },
    .{ .op = 0x21, .mnemonic = .@"and", .mode = .indirectX, .bytes = 2 },
    .{ .op = 0x31, .mnemonic = .@"and", .mode = .indirectY, .bytes = 2 },

    .{ .op = 0x09, .mnemonic = .ora, .mode = .immediate, .bytes = 2 },
    .{ .op = 0x05, .mnemonic = .ora, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0x15, .mnemonic = .ora, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0x0d, .mnemonic = .ora, .mode = .absolute, .bytes = 3 },
    .{ .op = 0x1d, .mnemonic = .ora, .mode = .absoluteX, .bytes = 3 },
    .{ .op = 0x19, .mnemonic = .ora, .mode = .absoluteY, .bytes = 3 },
    .{ .op = 0x01, .mnemonic = .ora, .mode = .indirectX, .bytes = 2 },
    .{ .op = 0x11, .mnemonic = .ora, .mode = .indirectY, .bytes = 2 },

    .{ .op = 0x49, .mnemonic = .eor, .mode = .immediate, .bytes = 2 },
    .{ .op = 0x45, .mnemonic = .eor, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0x55, .mnemonic = .eor, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0x4d, .mnemonic = .eor, .mode = .absolute, .bytes = 3 },
    .{ .op = 0x5d, .mnemonic = .eor, .mode = .absoluteX, .bytes = 3 },
    .{ .op = 0x59, .mnemonic = .eor, .mode = .absoluteY, .bytes = 3 },
    .{ .op = 0x41, .mnemonic = .eor, .mode = .indirectX, .bytes = 2 },
    .{ .op = 0x51, .mnemonic = .eor, .mode = .indirectY, .bytes = 2 },

    .{ .op = 0x69, .mnemonic = .adc, .mode = .immediate, .bytes = 2 },
    .{ .op = 0x65, .mnemonic = .adc, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0x75, .mnemonic = .adc, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0x6d, .mnemonic = .adc, .mode = .absolute, .bytes = 3 },
    .{ .op = 0x7d, .mnemonic = .adc, .mode = .absoluteX, .bytes = 3 },
    .{ .op = 0x79, .mnemonic = .adc, .mode = .absoluteY, .bytes = 3 },
    .{ .op = 0x61, .mnemonic = .adc, .mode = .indirectX, .bytes = 2 },
    .{ .op = 0x71, .mnemonic = .adc, .mode = .indirectY, .bytes = 2 },

    .{ .op = 0xe9, .mnemonic = .sbc, .mode = .immediate, .bytes = 2 },
    .{ .op = 0xe5, .mnemonic = .sbc, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0xf5, .mnemonic = .sbc, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0xed, .mnemonic = .sbc, .mode = .absolute, .bytes = 3 },
    .{ .op = 0xfd, .mnemonic = .sbc, .mode = .absoluteX, .bytes = 3 },
    .{ .op = 0xf9, .mnemonic = .sbc, .mode = .absoluteY, .bytes = 3 },
    .{ .op = 0xe1, .mnemonic = .sbc, .mode = .indirectX, .bytes = 2 },
    .{ .op = 0xf1, .mnemonic = .sbc, .mode = .indirectY, .bytes = 2 },

    .{ .op = 0x24, .mnemonic = .bit, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0x2c, .mnemonic = .bit, .mode = .absolute, .bytes = 3 },

    .{ .op = 0x0a, .mnemonic = .asl, .mode = .accumulator, .bytes = 1 },
    .{ .op = 0x06, .mnemonic = .asl, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0x16, .mnemonic = .asl, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0x0e, .mnemonic = .asl, .mode = .absolute, .bytes = 3 },
    .{ .op = 0x1e, .mnemonic = .asl, .mode = .absoluteX, .bytes = 3, .forceDummyRead = true },
    .{ .op = 0x2a, .mnemonic = .rol, .mode = .accumulator, .bytes = 1 },
    .{ .op = 0x26, .mnemonic = .rol, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0x36, .mnemonic = .rol, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0x2e, .mnemonic = .rol, .mode = .absolute, .bytes = 3 },
    .{ .op = 0x3e, .mnemonic = .rol, .mode = .absoluteX, .bytes = 3, .forceDummyRead = true },
    .{ .op = 0x4a, .mnemonic = .lsr, .mode = .accumulator, .bytes = 1 },
    .{ .op = 0x46, .mnemonic = .lsr, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0x56, .mnemonic = .lsr, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0x4e, .mnemonic = .lsr, .mode = .absolute, .bytes = 3 },
    .{ .op = 0x5e, .mnemonic = .lsr, .mode = .absoluteX, .bytes = 3, .forceDummyRead = true },
    .{ .op = 0x6a, .mnemonic = .ror, .mode = .accumulator, .bytes = 1 },
    .{ .op = 0x66, .mnemonic = .ror, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0x76, .mnemonic = .ror, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0x6e, .mnemonic = .ror, .mode = .absolute, .bytes = 3 },
    .{ .op = 0x7e, .mnemonic = .ror, .mode = .absoluteX, .bytes = 3, .forceDummyRead = true },

    .{ .op = 0xc9, .mnemonic = .cmp, .mode = .immediate, .bytes = 2 },
    .{ .op = 0xc5, .mnemonic = .cmp, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0xd5, .mnemonic = .cmp, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0xcd, .mnemonic = .cmp, .mode = .absolute, .bytes = 3 },
    .{ .op = 0xdd, .mnemonic = .cmp, .mode = .absoluteX, .bytes = 3 },
    .{ .op = 0xd9, .mnemonic = .cmp, .mode = .absoluteY, .bytes = 3 },
    .{ .op = 0xc1, .mnemonic = .cmp, .mode = .indirectX, .bytes = 2 },
    .{ .op = 0xd1, .mnemonic = .cmp, .mode = .indirectY, .bytes = 2 },

    .{ .op = 0xe0, .mnemonic = .cpx, .mode = .immediate, .bytes = 2 },
    .{ .op = 0xe4, .mnemonic = .cpx, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0xec, .mnemonic = .cpx, .mode = .absolute, .bytes = 3 },

    .{ .op = 0xc0, .mnemonic = .cpy, .mode = .immediate, .bytes = 2 },
    .{ .op = 0xc4, .mnemonic = .cpy, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0xcc, .mnemonic = .cpy, .mode = .absolute, .bytes = 3 },

    .{ .op = 0x90, .mnemonic = .bcc, .mode = .relative, .bytes = 2 },
    .{ .op = 0xb0, .mnemonic = .bcs, .mode = .relative, .bytes = 2 },
    .{ .op = 0xf0, .mnemonic = .beq, .mode = .relative, .bytes = 2 },
    .{ .op = 0xd0, .mnemonic = .bne, .mode = .relative, .bytes = 2 },
    .{ .op = 0x10, .mnemonic = .bpl, .mode = .relative, .bytes = 2 },
    .{ .op = 0x30, .mnemonic = .bmi, .mode = .relative, .bytes = 2 },
    .{ .op = 0x50, .mnemonic = .bvc, .mode = .relative, .bytes = 2 },
    .{ .op = 0x70, .mnemonic = .bvs, .mode = .relative, .bytes = 2 },

    .{ .op = 0x4c, .mnemonic = .jmp, .mode = .absolute, .bytes = 3 },
    .{ .op = 0x6c, .mnemonic = .jmp, .mode = .indirect, .bytes = 3 },
    .{ .op = 0x20, .mnemonic = .jsr, .mode = .jsrAbsolute, .bytes = 3 },
    .{ .op = 0x40, .mnemonic = .rti, .mode = .implied, .bytes = 1 },
    .{ .op = 0x60, .mnemonic = .rts, .mode = .implied, .bytes = 1 },

    .{ .op = 0xaa, .mnemonic = .tax, .mode = .implied, .bytes = 1 },
    .{ .op = 0x8a, .mnemonic = .txa, .mode = .implied, .bytes = 1 },
    .{ .op = 0xa8, .mnemonic = .tay, .mode = .implied, .bytes = 1 },
    .{ .op = 0x98, .mnemonic = .tya, .mode = .implied, .bytes = 1 },
    .{ .op = 0xba, .mnemonic = .tsx, .mode = .implied, .bytes = 1 },
    .{ .op = 0x9a, .mnemonic = .txs, .mode = .implied, .bytes = 1 },

    .{ .op = 0xe8, .mnemonic = .inx, .mode = .implied, .bytes = 1 },
    .{ .op = 0xca, .mnemonic = .dex, .mode = .implied, .bytes = 1 },
    .{ .op = 0xc8, .mnemonic = .iny, .mode = .implied, .bytes = 1 },
    .{ .op = 0x88, .mnemonic = .dey, .mode = .implied, .bytes = 1 },

    .{ .op = 0xe6, .mnemonic = .inc, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0xf6, .mnemonic = .inc, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0xee, .mnemonic = .inc, .mode = .absolute, .bytes = 3 },
    .{ .op = 0xfe, .mnemonic = .inc, .mode = .absoluteX, .bytes = 3, .forceDummyRead = true },
    .{ .op = 0xc6, .mnemonic = .dec, .mode = .zeroPage, .bytes = 2 },
    .{ .op = 0xd6, .mnemonic = .dec, .mode = .zeroPageX, .bytes = 2 },
    .{ .op = 0xce, .mnemonic = .dec, .mode = .absolute, .bytes = 3 },
    .{ .op = 0xde, .mnemonic = .dec, .mode = .absoluteX, .bytes = 3, .forceDummyRead = true },

    .{ .op = 0x18, .mnemonic = .clc, .mode = .implied, .bytes = 1 },
    .{ .op = 0x38, .mnemonic = .sec, .mode = .implied, .bytes = 1 },
    .{ .op = 0x58, .mnemonic = .cli, .mode = .implied, .bytes = 1 },
    .{ .op = 0x78, .mnemonic = .sei, .mode = .implied, .bytes = 1 },
    .{ .op = 0xd8, .mnemonic = .cld, .mode = .implied, .bytes = 1 },
    .{ .op = 0xf8, .mnemonic = .sed, .mode = .implied, .bytes = 1 },
    .{ .op = 0xb8, .mnemonic = .clv, .mode = .implied, .bytes = 1 },

    .{ .op = 0x48, .mnemonic = .pha, .mode = .implied, .bytes = 1 },
    .{ .op = 0x08, .mnemonic = .php, .mode = .implied, .bytes = 1 },
